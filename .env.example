# Development example only. .env is ignored by Git; this example contains no secrets.
DEBUG=True
SECRET_KEY=replace-with-a-locally-generated-random-value
# Comma-separated hostnames, without scheme/path/port. Keep the existing VPOD host.
ALLOWED_HOSTS=visphys.eemb.ucsb.edu,localhost,127.0.0.1
VPOD_DATABASE=sqlite
# ALWAYS set a separate path for development, migrations and imports.
VPOD_SQLITE_PATH=/tmp/vpod-development.sqlite3
VPOD_STATIC_ROOT=/tmp/vpod-static
VPOD_LOG_PATH=/tmp/vpod-django-errors.log
# Optional identified bibliographic API access: use a real maintainer contact.
# METADATA_MAILTO=curator@example.org
# PostgreSQL selection: install requirements-postgres.txt and set VPOD_DATABASE=postgres.
# POSTGRES_DB=vpod_development
# POSTGRES_USER=vpod_development
# POSTGRES_PASSWORD=replace-with-local-development-password
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
